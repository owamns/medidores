# Entorno
FLASK_ENV=production
PORT=5000

# Configuración de dispositivo
# auto: detecta automáticamente GPU/CPU
# gpu/cuda: fuerza uso de GPU
# cpu: fuerza uso de CPU
DEVICE=auto

# Configuración de Gunicorn para GPU
GUNICORN_GPU_WORKERS=1
GUNICORN_GPU_WORKER_CLASS=gthread
GUNICORN_GPU_THREADS=4
GUNICORN_GPU_TIMEOUT=600
GUNICORN_GPU_KEEPALIVE=120
GUNICORN_GPU_MAX_REQUESTS=5001
GUNICORN_GPU_MAX_REQUESTS_JITTER=50
GUNICORN_GPU_GRACEFUL_TIMEOUT=120

# Configuración de Gunicorn para CPU
GUNICORN_CPU_WORKERS=3
GUNICORN_CPU_WORKER_CLASS=sync
GUNICORN_CPU_THREADS=2
GUNICORN_CPU_TIMEOUT=120
GUNICORN_CPU_KEEPALIVE=60
GUNICORN_CPU_MAX_REQUESTS=1000
GUNICORN_CPU_MAX_REQUESTS_JITTER=100
GUNICORN_CPU_GRACEFUL_TIMEOUT=60

# Aplicación
MAX_CONTENT_LENGTH=33554432
PYTHONPATH=/app

# Modelos
CROP_MODEL_PATH=models/best-recorte.pt
DIGITAL_MODEL_PATH=models/best-digital.pt
ELECTRONIC_MODEL_PATH=models/best-electronico.pt
SCALE_FACTOR=4
CONF_THRESHOLD=0

# Recursos del contenedor
MEMORY_LIMIT=4G
MEMORY_RESERVATION=2G
CPU_LIMIT=4.0
CPU_RESERVATION=2.0

# Logging
LOG_LEVEL=INFO
ACCESS_LOG_FORMAT='%(h)s %(l)s %(u)s %(t)s "%(r)s" %(s)s %(b)s "%(f)s" "%(a)s" %(D)s'

# Health Check
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=15s
HEALTH_CHECK_RETRIES=3
HEALTH_CHECK_START_PERIOD=120s

# Configuración específica para GPU
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility
CUDA_VISIBLE_DEVICES=0